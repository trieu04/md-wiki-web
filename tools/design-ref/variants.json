      "clicks": [
        ["checkbox", "^Checked against source", "aria-checked", "false"],
        ["checkbox", "^Reviewed", "aria-checked", "false"],
        ["checkbox", "^Not reviewed", "aria-checked", "false"],
        ["checkbox", "^Confirmed error", "aria-checked", "false"]
      ]
    }
  },
  "Page": {
    "principle": {},
    "overview": { "clicks": [["button", "^Overview$", "aria-current", "location"]] },
    "resolution": { "clicks": [["button", "^Resolution$", "aria-current", "location"]] },
    "detectors": { "clicks": [["button", "^Detectors$", "aria-current", "location"]] },
    "history": { "clicks": [["button", "^History$", "aria-current", "location"]] },
