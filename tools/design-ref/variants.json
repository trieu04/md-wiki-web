  "Trust": {
    "why": {
      "props": { "mode": "why" },
      "expect": "[role=tab][aria-selected=true]:has-text('Why this label')"
    },
    "check": {
      "props": { "mode": "check" },
      "expect": "[role=tab][aria-selected=true]:has-text('I checked a source')"
    },
    "check-partly": {
      "props": { "mode": "check" },
      "clicks": [["radio", "^Partly", "aria-checked"]]
    },
    "check-contradicts": {
      "props": { "mode": "check" },
      "clicks": [["radio", "^It contradicts the text", "aria-checked"]]
    },
    "check-cant": {
      "props": { "mode": "check" },
      "clicks": [["radio", "^I couldn’t check", "aria-checked"]]
    },
    "check-done": {
      "props": { "mode": "check" },
      "clicks": [["button", "^Save source check$"]],
      "expect": "[role=status]:has-text('Source check saved')"
    },
    "check-contradicts-done": {
      "props": { "mode": "check" },
      "clicks": [
        ["radio", "^It contradicts the text", "aria-checked"],
        ["button", "^Save check and send report$"]
      ],
      "expect": "[role=status]:has-text('the page authors got a report too')"
    },
    "use": {
      "props": { "mode": "use" },
      "expect": "[role=tab][aria-selected=true]:has-text('I used it')"
    },
    "use-changes": {
      "props": { "mode": "use" },
      "clicks": [["button", "^With changes$", "aria-pressed"]]
    },
    "use-no": { "props": { "mode": "use" }, "clicks": [["button", "^No$", "aria-pressed"]] },
    "use-done": {
      "props": { "mode": "use" },
      "clicks": [["button", "^Save$"]],
      "expect": "[role=status]:has-text('Thanks, saved for your team')"
    },
    "report": {
      "props": { "mode": "report" },
      "expect": "[role=tab][aria-selected=true]:has-text('Report a problem')"
    },
    "report-outdated": {
      "props": { "mode": "report" },
      "clicks": [["button", "^Outdated$", "aria-pressed"]]
    },
    "report-unclear": {
      "props": { "mode": "report" },
      "clicks": [["button", "^Unclear$", "aria-pressed"]]
    },
    "report-source": {
      "props": { "mode": "report" },
      "clicks": [["button", "^Missing or weak source$", "aria-pressed"]]
    },
    "report-other": {
      "props": { "mode": "report" },
      "clicks": [["button", "^Something else$", "aria-pressed"]]
    },
    "report-done": {
      "props": { "mode": "report" },
      "clicks": [["button", "^Send report$"]],
      "expect": "[role=status]:has-text('Report sent')"
    }
