{
  "name": "@md-wiki/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "prisma migrate deploy && tsx watch src/main.ts",
    "lint": "eslint src test scripts vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tooling.json",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@md-wiki/contracts": "workspace:*",
    "@md-wiki/domain": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.8",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "ajv": "^8.20.0",
    "bullmq": "^6.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "parse5": "^8.1.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.12",
    "@types/supertest": "^7.2.1",
    "prisma": "6.19.3",
    "supertest": "^7.3.2",
    "tsx": "^4.20.6",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.4"
  }
}
