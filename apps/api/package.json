{
  "name": "@md-wiki/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tooling.json",
    "test": "vitest run && node --input-type=module -e \"const d = await import('@md-wiki/domain'); const c = await import('@md-wiki/contracts'); if (d.domainPlaceholder !== 'md-wiki-domain' || c.contractsPlaceholder !== 'md-wiki-contracts') throw new Error('Workspace package imports failed')\""
  },
  "dependencies": {
    "@md-wiki/contracts": "workspace:*",
    "@md-wiki/domain": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.12",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.4"
  }
}
