generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  reader
  contributor
  reviewer
  publisher
  owner
}

enum Scope {
  read
  contribute
  discuss
  review
  publish
}

enum Label {
  checked
  reviewed
  not_reviewed
  recheck
  error
}

enum UserKind {
  human
  agent
}

enum ActorKind {
  human
  agent
  system
}

model Team {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  slug      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model User {
  id           String               @id @default(uuid(7)) @db.Uuid
  email        String               @unique @db.Citext
  name         String
  kind         UserKind
  roles        Role[]
  teamId       String?              @db.Uuid
  team         Team?                @relation(fields: [teamId], references: [id])
  passwordHash String?
  disabledAt   DateTime?            @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  tokens       ApiToken[]
  events       AuditEvent[]
  drafts       Draft[]
  proposals    Proposal[]
  assignments  Assignment[]         @relation("assignee")
  assigned     Assignment[]         @relation("assignedBy")
  decisions    Decision[]
  publications Publication[]
  resolutions  Resolution[]
  conflicts    ConflictResolution[]
  withdrawals  Withdrawal[]
  topics       Topic[]
  closedTopics Topic[]              @relation("closedBy")
  entries      DiscussionEvent[]
  disputes     DisputeEvent[]
  aiJobs       AiJob[]
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique
  csrfToken  String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)
  ip         String
  userAgent  String
}

model ApiToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  name       String
  prefix     String    @unique
  tokenHash  String
  scopes     Scope[]
  expiresAt  DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
}

model Page {
  id                   String   @id @default(uuid(7)) @db.Uuid
  path                 String   @unique
  title                String
  topic                String
  isMeta               Boolean
  currentVersionLabel  String
  currentSha256        String
  changedOutsideReview Boolean  @default(false)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
}

model Snapshot {
  id         String   @id @default(uuid(7)) @db.Uuid
  path       String
  label      String
  sha256     String
  content    Bytes
  capturedAt DateTime @default(now()) @db.Timestamptz(3)

  drafts    Draft[]
  proposals Proposal[]
  refs      ProposalRef[]

  @@unique([path, label])
  @@index([path, sha256])
}

model PageSection {
  path         String
  versionLabel String
  anchor       String
  title        String
  level        Int
  ord          Int
  sectionHash  String
  text         String
  search       Unsupported("tsvector") @default(dbgenerated())

  @@id([path, versionLabel, anchor])
  @@index([search], type: Gin)
}

model AuditEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  actorId     String?   @db.Uuid
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorKind   ActorKind
  action      String
  subjectType String
  subjectId   String
  data        Json
  at          DateTime  @default(now()) @db.Timestamptz(3)

  @@index([action, subjectId, at])
}

enum AiJobKind {
  ping
  quality_check
  agent_review
  retraction_check
  copy_candidates
  relation_candidates
  credibility_score
}

enum AiJobStatus {
  queued
  running
  succeeded
  failed
}

// Phase 7 — quality check (system-logic §7.6.1)
enum AiJobTrigger {
  dev
  submit
  rerun
  self_check
  after_check
  returned
  resumed
  manual
  weekly
  daily
  internal
}

enum FindingSeverity {
  info
  warning
  blocking
}

enum FindingOrigin {
  model
  rule
}

model AiJob {
  id            String       @id @default(uuid(7)) @db.Uuid
  kind          AiJobKind
  status        AiJobStatus  @default(queued)
  input         Json
  output        Json?
  error         Json?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  startedAt     DateTime?    @db.Timestamptz(3)
  finishedAt    DateTime?    @db.Timestamptz(3)
  trigger       AiJobTrigger @default(dev)
  proposalId    String?      @db.Uuid
  proposal      Proposal?    @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  draftId       String?      @db.Uuid
  requestedById String?      @db.Uuid
  requestedBy   User?        @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  bundleHash    String?
  rulesSha256   String?
  provider      String?
  model         String?
  promptVersion String?
  tokensIn      Int?
  tokensOut     Int?
  dropped       Json?
  findings      Finding[]
  agentReview   AgentReview?
  /// Credibility jobs (§7.7.12): when the public app applied the output (D-230).
  appliedAt     DateTime?    @db.Timestamptz(3)

  @@index([proposalId, createdAt])
  @@index([draftId, createdAt])
  @@index([kind, createdAt])
  @@index([status, createdAt])
}

model Finding {
  id         String          @id @default(uuid(7)) @db.Uuid
  jobId      String          @db.Uuid
  job        AiJob           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  proposalId String?         @db.Uuid
  proposal   Proposal?       @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  draftId    String?         @db.Uuid
  ord        Int
  rule       String
  severity   FindingSeverity
  message    String
  block      String
  quote      String
  lineStart  Int?
  lineEnd    Int?
  origin     FindingOrigin
  original   Json?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([jobId, ord])
  @@index([proposalId])
}

// Phase 4 — Contribute (system-logic §7.2.1)
enum ProposalState {
  pending
  approved
  published
  rejected
  stale
}

enum ProposalOrigin {
  editor
  api
  import
}

enum ProposalRefRole {
  target
  scope
  source
}

model Draft {
  id             String    @id @default(uuid(7)) @db.Uuid
  authorId       String    @db.Uuid
  author         User      @relation(fields: [authorId], references: [id])
  targetPath     String
  baseSnapshotId String?   @db.Uuid
  baseSnapshot   Snapshot? @relation(fields: [baseSnapshotId], references: [id])
  scope          Json
  title          String    @default("")
  content        String
  reason         String    @default("")
  sources        Json
  appliesTo      Json
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @db.Timestamptz(3)

  @@unique([authorId, targetPath])
  @@index([authorId, updatedAt])
}

model Proposal {
  id             String               @id @default(uuid(7)) @db.Uuid
  slug           String               @unique
  title          String
  targetPath     String
  section        String?
  submitterId    String               @db.Uuid
  submitter      User                 @relation(fields: [submitterId], references: [id])
  origin         ProposalOrigin
  state          ProposalState        @default(pending)
  reason         String
  bundleHash     String
  manifest       Bytes
  base           Bytes?
  proposed       Bytes
  artifact       Bytes?
  artifactHash   String?
  baseSha256     String?
  baseSnapshotId String?              @db.Uuid
  baseSnapshot   Snapshot?            @relation(fields: [baseSnapshotId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @db.Timestamptz(3)
  refs           ProposalRef[]
  assignments    Assignment[]
  decision       Decision?
  publications   Publication[]
  conflict       ConflictResolution?  @relation("conflicted")
  replaces       ConflictResolution[] @relation("replacement")
  withdrawal     Withdrawal?
  outbox         PublishOutbox[]
  topic          Topic?
  disputes       DisputeEvent[]
  aiJobs         AiJob[]
  findings       Finding[]
  escalations    Escalation[]
  agentReviews   AgentReview[]
  spotCheck      SpotCheck?

  @@index([submitterId, createdAt])
  @@index([targetPath, state])
}

model ProposalRef {
  id         String          @id @default(uuid(7)) @db.Uuid
  proposalId String          @db.Uuid
  proposal   Proposal        @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  snapshotId String          @db.Uuid
  snapshot   Snapshot        @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  role       ProposalRefRole
  impact     String?
  ord        Int

  @@unique([proposalId, role, snapshotId])
}

// Phase 5 — Review and publish (system-logic §7.4.1)
enum PublicationPhase {
  prepared
  writing
  written
  done
  unknown
  stale
  not_written
}

enum ResolutionOutcome {
  written
  not_written
}

enum ConflictOutcome {
  keep_current
  use_incoming
  merge
}

enum ReviewerKind {
  agent
  person
}

enum OutboxKind {
  approval
  retry
}

model Assignment {
  id          String    @id @default(uuid(7)) @db.Uuid
  proposalId  String    @db.Uuid
  proposal    Proposal  @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  assigneeId  String    @db.Uuid
  assignee    User      @relation("assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  reason      String
  trigger     String?
  createdById String?   @db.Uuid
  createdBy   User?     @relation("assignedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  closedAt    DateTime? @db.Timestamptz(3)

  @@index([proposalId])
  @@index([assigneeId, closedAt])
}

model Decision {
  id                String          @id @db.Uuid
  proposalId        String          @unique @db.Uuid
  proposal          Proposal        @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  reviewerId        String          @db.Uuid
  reviewer          User            @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewerKind      ReviewerKind
  approve           Boolean
  reason            String
  bundleHash        String
  artifactHash      String
  previewAt         DateTime        @db.Timestamptz(3)
  discussionVersion Int
  disputeVersion    Int
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  publications      Publication[]
  outbox            PublishOutbox[]
}

model Publication {
  id           String             @id @default(uuid(7)) @db.Uuid
  proposalId   String             @db.Uuid
  proposal     Proposal           @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  attempt      Int
  targetPath   String
  decisionId   String             @db.Uuid
  decision     Decision           @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  phase        PublicationPhase
  auto         Boolean
  actorId      String?            @db.Uuid
  actor        User?              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  baseSha256   String?
  artifactHash String
  condition    Json
  receipt      Json?
  error        String?
  versionLabel String?
  startedAt    DateTime           @default(now()) @db.Timestamptz(3)
  writtenAt    DateTime?          @db.Timestamptz(3)
  finishedAt   DateTime?          @db.Timestamptz(3)
  updatedAt    DateTime           @default(now()) @db.Timestamptz(3)
  resolution   Resolution?
  sections     PublishedSection[]

  @@unique([proposalId, attempt])
  @@index([targetPath, phase])
}

model Resolution {
  id            String            @id @default(uuid(7)) @db.Uuid
  publicationId String            @unique @db.Uuid
  publication   Publication       @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  proposalId    String            @db.Uuid
  actorId       String            @db.Uuid
  actor         User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  outcome       ResolutionOutcome
  evidence      String
  diskSha256    String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
}

model ConflictResolution {
  id            String          @id @default(uuid(7)) @db.Uuid
  proposalId    String          @unique @db.Uuid
  proposal      Proposal        @relation("conflicted", fields: [proposalId], references: [id], onDelete: Restrict)
  actorId       String          @db.Uuid
  actor         User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  outcome       ConflictOutcome
  baseSha256    String?
  currentSha256 String?
  replacementId String?         @db.Uuid
  replacement   Proposal?       @relation("replacement", fields: [replacementId], references: [id], onDelete: Restrict)
  reason        String
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
}

model Withdrawal {
  id         String   @id @default(uuid(7)) @db.Uuid
  proposalId String   @unique @db.Uuid
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  actorId    String   @db.Uuid
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
}

model PublishOutbox {
  id          String     @id @default(uuid(7)) @db.Uuid
  proposalId  String     @db.Uuid
  proposal    Proposal   @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  decisionId  String     @db.Uuid
  decision    Decision   @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  kind        OutboxKind
  attempts    Int        @default(0)
  lastError   String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  processedAt DateTime?  @db.Timestamptz(3)

  @@index([processedAt])
}

model PublishedSection {
  publicationId String       @db.Uuid
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  path          String
  versionLabel  String
  anchor        String
  sectionHash   String
  reviewerKind  ReviewerKind
  reviewedAt    DateTime     @db.Timestamptz(3)

  @@id([publicationId, anchor])
  @@index([path, anchor, sectionHash])
}

// ---- Phase 6: discussions (system-logic §7.5.1) ----------------------------------------------

enum TopicStatus {
  open
  on_hold
  resolved
  rejected
}

enum EntryKind {
  open
  comment
  agreement
  close
  reopen
}

enum DisputeAction {
  open
  comment
  resolve
  reopen
}

model Topic {
  id             String            @id @default(uuid(7)) @db.Uuid
  path           String
  anchor         String?
  versionLabel   String?
  title          String
  authorId       String            @db.Uuid
  author         User              @relation(fields: [authorId], references: [id])
  status         TopicStatus       @default(open)
  proposalId     String?           @unique @db.Uuid
  proposal       Proposal?         @relation(fields: [proposalId], references: [id])
  bundleHash     String?
  version        Int               @default(1)
  participantIds String[]          @db.Uuid
  closedById     String?           @db.Uuid
  closedBy       User?             @relation("closedBy", fields: [closedById], references: [id])
  closeReason    String?
  closedAt       DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @db.Timestamptz(3)
  entries        DiscussionEvent[]

  @@index([path, anchor])
  @@index([status, updatedAt])
  @@index([updatedAt, id])
}

model DiscussionEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  topicId    String       @db.Uuid
  topic      Topic        @relation(fields: [topicId], references: [id])
  seq        Int
  kind       EntryKind
  authorId   String       @db.Uuid
  author     User         @relation(fields: [authorId], references: [id])
  body       String
  parentSeq  Int?
  agreesWith Int?
  outcome    TopicStatus?
  mentions   String[]     @db.Uuid
  bundleHash String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([topicId, seq])
}

model DisputeEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  proposalId     String        @db.Uuid
  proposal       Proposal      @relation(fields: [proposalId], references: [id])
  seq            Int
  actorId        String        @db.Uuid
  actor          User          @relation(fields: [actorId], references: [id])
  action         DisputeAction
  reason         String
  resolutionKind String?
  relatedSlugs   String[]
  bundleHash     String
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([proposalId, seq])
}

// ---- Phase 8: self-managed review (system-logic §7.8.1) ----------------------------------------
// User references are plain uuid columns (users are disabled, never deleted).

enum ReviewModel {
  self_managed
  human
}

enum EscalationKind {
  rereview
  discussion
}

enum EscalationResolution {
  decided
  withdrawn
  discussion_closed
}

enum AgentOutcome {
  approved
  rejected
  escalated
  left_pending
}

enum SpotCheckOutcome {
  passed
  failed
}

/// Singleton (id = 1): Settings › Review and the stop switch (D-202, D-211).
model ReviewSettings {
  id                   Int         @id @default(1)
  reviewModel          ReviewModel @default(self_managed)
  reviewerAgentId      String?     @db.Uuid
  agentPaused          Boolean     @default(false)
  pausedAt             DateTime?   @db.Timestamptz(3)
  pausedById           String?     @db.Uuid
  pauseReason          String?
  agentEditsHumanPages Boolean     @default(true)
  customTriggers       Json        @default("[]")
  spotCheckRate        Float       @default(0.1)
  reminderDays         Int         @default(2)
  autoPublishSeen      Boolean?
  updatedAt            DateTime?   @db.Timestamptz(3)
  updatedById          String?     @db.Uuid
}

model Escalation {
  id             String                @id @default(uuid(7)) @db.Uuid
  proposalId     String                @db.Uuid
  proposal       Proposal              @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  kind           EscalationKind
  triggers       String[]
  notes          String
  requestedById  String                @db.Uuid
  bundleHash     String
  assigneeIds    String[]              @db.Uuid
  topicId        String?               @db.Uuid
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime?             @db.Timestamptz(3)
  resolution     EscalationResolution?
  reminders      Int                   @default(0)
  lastRemindedAt DateTime?             @db.Timestamptz(3)

  @@index([proposalId, createdAt])
  @@index([resolvedAt])
}

/// One row per succeeded agent_review job (append-only).
model AgentReview {
  id            String       @id @default(uuid(7)) @db.Uuid
  jobId         String       @unique @db.Uuid
  job           AiJob        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  proposalId    String       @db.Uuid
  proposal      Proposal     @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  bundleHash    String
  outcome       AgentOutcome
  verdict       String?
  notes         String
  claims        Json
  refusals      Json
  decisionId    String?      @db.Uuid
  escalationId  String?      @db.Uuid
  provider      String?
  model         String?
  promptVersion String
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([proposalId, createdAt])
  @@index([createdAt])
}

/// A sampled agent approval checked after publication (D-213, D-214); decided once.
model SpotCheck {
  id            String            @id @default(uuid(7)) @db.Uuid
  proposalId    String            @unique @db.Uuid
  proposal      Proposal          @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  decisionId    String            @unique @db.Uuid
  publicationId String            @db.Uuid
  path          String
  versionLabel  String
  reviewerId    String            @db.Uuid
  assigneeIds   String[]          @db.Uuid
  sampledAt     DateTime          @default(now()) @db.Timestamptz(3)
  outcome       SpotCheckOutcome?
  reason        String?
  anchors       String[]
  decidedById   String?           @db.Uuid
  decidedAt     DateTime?         @db.Timestamptz(3)

  @@index([sampledAt])
}

/// After-publication work done once per publication: digest and sampling (append-only).
model PublishFollowUp {
  publicationId String   @id @db.Uuid
  proposalId    String   @db.Uuid
  sampled       Boolean
  spotCheckId   String?  @db.Uuid
  notified      String[] @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
}

// ---- Phase 9: credibility (system-logic §7.7.1) ----------------------------------------------
// Records reference users, topics, proposals and snapshots by id without relations (D-160).

enum SourceCheckResult {
  supported
  not_supported
  unverifiable
}

enum AttestationKind {
  useful
  checked
  used
  report
}

enum AttestationStatus {
  withdrawn
  confirmed
  confirmed_error
  dismissed
  fixed
  downweighted
}

enum InvalidationKind {
  retraction
  concern
  source_changed
  version_changed
  contradiction
  root_wrong
}

enum ErrorOrigin {
  report
  source_check
  flag
  spot_check
  manual
}

enum FlagCause {
  report
  retraction
  source_changed
  version_changed
  contradiction
  root_wrong
  propagated
}

enum EdgeKind {
  copy
  corroborates
  contradicts
  lab_data
}

enum FollowReason {
  manual
  attested
  contributed
}

enum NotificationChannel {
  in_app
  email_daily
  off
}

enum FeedbackAnswer {
  yes
  partly
  no
}

model SourceCheck {
  id               String            @id @default(uuid(7)) @db.Uuid
  path             String
  anchor           String
  sectionHash      String
  versionLabel     String
  sourceRef        String
  sourceTitle      String?
  sourceSnapshotId String?           @db.Uuid
  result           SourceCheckResult
  excerpt          String?
  location         String?
  comparedNumbers  Boolean           @default(false)
  note             String?
  checkerId        String            @db.Uuid
  checkerKind      ReviewerKind
  proposalId       String?           @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)

  @@index([path, anchor, sectionHash])
  @@index([sourceRef])
}

model OwnerConfirmation {
  id           String   @id @default(uuid(7)) @db.Uuid
  path         String
  anchor       String
  sectionHash  String
  versionLabel String
  ownerId      String   @db.Uuid
  note         String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([path, anchor, sectionHash])
}

model InvalidationEvent {
  id           String           @id @default(uuid(7)) @db.Uuid
  kind         InvalidationKind
  ref          String
  detail       String
  detectedAt   DateTime         @default(now()) @db.Timestamptz(3)
  recordedById String?          @db.Uuid
  jobId        String?          @db.Uuid

  @@index([ref])
}

model ConfirmedError {
  id            String      @id @default(uuid(7)) @db.Uuid
  path          String
  anchor        String
  sectionHash   String
  reason        String
  origin        ErrorOrigin
  originId      String?     @db.Uuid
  confirmedById String      @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([path, anchor, sectionHash])
}

model RecheckFlag {
  id          String    @id @default(uuid(7)) @db.Uuid
  path        String
  anchor      String
  sectionHash String
  cause       FlagCause
  causeId     String?   @db.Uuid
  reason      String
  depth       Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([path, anchor, sectionHash])
  @@index([causeId])
}

model CredibilityResolution {
  id          String   @id @default(uuid(7)) @db.Uuid
  subjectType String
  subjectId   String   @db.Uuid
  path        String?
  anchor      String?
  sectionHash String?
  outcome     String
  reason      String
  actorId     String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([subjectId])
}

model Attestation {
  id           String          @id @default(uuid(7)) @db.Uuid
  path         String
  anchor       String
  sectionHash  String
  versionLabel String
  actorId      String          @db.Uuid
  teamId       String?         @db.Uuid
  role         Role
  kind         AttestationKind
  details      Json
  blocking     Boolean         @default(false)
  note         String?
  sawCounts    Boolean
  topicId      String?         @db.Uuid
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  @@index([path, anchor, sectionHash])
  @@index([actorId, createdAt])
}

model AttestationEvent {
  id            String            @id @default(uuid(7)) @db.Uuid
  attestationId String            @db.Uuid
  seq           Int
  actorId       String?           @db.Uuid
  status        AttestationStatus
  reason        String
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([attestationId, seq])
}

model PageFeedback {
  id           String         @id @default(uuid(7)) @db.Uuid
  path         String
  versionLabel String
  actorId      String         @db.Uuid
  teamId       String?        @db.Uuid
  answer       FeedbackAnswer
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([path, versionLabel])
}

model CredibilityAggregate {
  path         String
  anchor       String
  sectionHash  String
  versionLabel String
  metric       String
  teamKey      String
  count        Int
  updatedAt    DateTime @default(now()) @db.Timestamptz(3)

  @@id([path, anchor, sectionHash, versionLabel, metric, teamKey])
}

model EdgeCandidate {
  id        String   @id @default(uuid(7)) @db.Uuid
  kind      EdgeKind
  srcPath   String
  srcAnchor String
  dstPath   String
  dstAnchor String
  score     Float
  jobId     String?  @db.Uuid
  detail    Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model CredibilityEdge {
  id            String   @id @default(uuid(7)) @db.Uuid
  kind          EdgeKind
  srcPath       String
  srcAnchor     String
  dstPath       String
  dstAnchor     String
  candidateId   String?  @db.Uuid
  confirmedById String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([srcPath, srcAnchor])
  @@index([dstPath, dstAnchor])
}

model AnchorLink {
  id         String   @id @default(uuid(7)) @db.Uuid
  path       String
  oldAnchor  String
  oldHash    String
  newAnchor  String
  newHash    String
  proposalId String?  @db.Uuid
  reviewerId String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([path, newAnchor, newHash, oldAnchor, oldHash])
}

model Follow {
  userId    String       @db.Uuid
  path      String
  anchor    String       @default("")
  reason    FollowReason
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  mutedAt   DateTime?    @db.Timestamptz(3)

  @@id([userId, path, anchor])
  @@index([path])
}

model NotificationPref {
  userId  String              @db.Uuid
  event   String
  channel NotificationChannel

  @@id([userId, event])
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  event     String
  path      String?
  anchor    String?
  data      Json
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)
  emailedAt DateTime? @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model CredibilityGate {
  capability String   @id
  enabled    Boolean  @default(false)
  runRecord  String?
  runDate    String?
  actorId    String?  @db.Uuid
  updatedAt  DateTime @default(now()) @db.Timestamptz(3)
}

/// Shadow score cache (system-logic §7.7.12, D-231): Operations and research export only.
model SectionScore {
  path         String
  anchor       String
  sectionHash  String
  p            Float
  lower10      Float
  u            Float
  r            Float
  s            Float
  flagged      Boolean
  reach        Int
  modelVersion String
  paramsSha256 String
  jobId        String   @db.Uuid
  computedAt   DateTime @db.Timestamptz(3)

  @@id([path, anchor, sectionHash])
  @@index([computedAt])
}
