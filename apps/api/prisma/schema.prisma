generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  reader
  contributor
  reviewer
  publisher
  owner
}

enum Scope {
  read
  contribute
  discuss
  review
  publish
}

enum Label {
  checked
  reviewed
  not_reviewed
  recheck
  error
}

enum UserKind {
  human
  agent
}

enum ActorKind {
  human
  agent
  system
}

model Team {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  slug      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model User {
  id           String       @id @default(uuid(7)) @db.Uuid
  email        String       @unique @db.Citext
  name         String
  kind         UserKind
  roles        Role[]
  teamId       String?      @db.Uuid
  team         Team?        @relation(fields: [teamId], references: [id])
  passwordHash String?
  disabledAt   DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  tokens       ApiToken[]
  events       AuditEvent[]
  drafts       Draft[]
  proposals    Proposal[]
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique
  csrfToken  String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)
  ip         String
  userAgent  String
}

model ApiToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  name       String
  prefix     String    @unique
  tokenHash  String
  scopes     Scope[]
  expiresAt  DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
}

model Page {
  id                   String   @id @default(uuid(7)) @db.Uuid
  path                 String   @unique
  title                String
  topic                String
  isMeta               Boolean
  currentVersionLabel  String
  currentSha256        String
  changedOutsideReview Boolean  @default(false)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
}

model Snapshot {
  id         String   @id @default(uuid(7)) @db.Uuid
  path       String
  label      String
  sha256     String
  content    Bytes
  capturedAt DateTime @default(now()) @db.Timestamptz(3)

  drafts    Draft[]
  proposals Proposal[]
  refs      ProposalRef[]

  @@unique([path, label])
  @@index([path, sha256])
}

model PageSection {
  path         String
  versionLabel String
  anchor       String
  title        String
  level        Int
  ord          Int
  sectionHash  String
  text         String
  search       Unsupported("tsvector") @default(dbgenerated())

  @@id([path, versionLabel, anchor])
  @@index([search], type: Gin)
}

model AuditEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  actorId     String?   @db.Uuid
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorKind   ActorKind
  action      String
  subjectType String
  subjectId   String
  data        Json
  at          DateTime  @default(now()) @db.Timestamptz(3)

  @@index([action, subjectId, at])
}

enum AiJobKind {
  ping
}

enum AiJobStatus {
  queued
  running
  succeeded
  failed
}

model AiJob {
  id         String      @id @default(uuid(7)) @db.Uuid
  kind       AiJobKind
  status     AiJobStatus @default(queued)
  input      Json
  output     Json?
  error      Json?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  startedAt  DateTime?   @db.Timestamptz(3)
  finishedAt DateTime?   @db.Timestamptz(3)
}

// Phase 4 — Contribute (system-logic §7.2.1)
enum ProposalState {
  pending
  approved
  published
  rejected
  stale
}

enum ProposalOrigin {
  editor
  api
  import
}

enum ProposalRefRole {
  target
  scope
  source
}

model Draft {
  id             String    @id @default(uuid(7)) @db.Uuid
  authorId       String    @db.Uuid
  author         User      @relation(fields: [authorId], references: [id])
  targetPath     String
  baseSnapshotId String?   @db.Uuid
  baseSnapshot   Snapshot? @relation(fields: [baseSnapshotId], references: [id])
  scope          Json
  title          String    @default("")
  content        String
  reason         String    @default("")
  sources        Json
  appliesTo      Json
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @db.Timestamptz(3)

  @@unique([authorId, targetPath])
  @@index([authorId, updatedAt])
}

model Proposal {
  id             String         @id @default(uuid(7)) @db.Uuid
  slug           String         @unique
  title          String
  targetPath     String
  section        String?
  submitterId    String         @db.Uuid
  submitter      User           @relation(fields: [submitterId], references: [id])
  origin         ProposalOrigin
  state          ProposalState  @default(pending)
  reason         String
  bundleHash     String
  manifest       Bytes
  base           Bytes?
  proposed       Bytes
  artifact       Bytes?
  artifactHash   String?
  baseSha256     String?
  baseSnapshotId String?        @db.Uuid
  baseSnapshot   Snapshot?      @relation(fields: [baseSnapshotId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @db.Timestamptz(3)
  refs           ProposalRef[]

  @@index([submitterId, createdAt])
  @@index([targetPath, state])
}

model ProposalRef {
  id         String          @id @default(uuid(7)) @db.Uuid
  proposalId String          @db.Uuid
  proposal   Proposal        @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  snapshotId String          @db.Uuid
  snapshot   Snapshot        @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  role       ProposalRefRole
  impact     String?
  ord        Int

  @@unique([proposalId, role, snapshotId])
}
