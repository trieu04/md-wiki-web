DATABASE_URL=postgresql://mdwiki:mdwiki-local@localhost:5432/mdwiki
REDIS_URL=redis://localhost:6379
API_PORT=3000
API_HOST=127.0.0.1
INTERNAL_PORT=3001
# 0.0.0.0 inside a container on the private compose network; never publish the port
INTERNAL_HOST=127.0.0.1
SERVICE_TOKEN=replace-with-a-local-service-token
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD=replace-with-a-local-password
WIKI_ROOT=./wiki-sample
AUTO_PUBLISH=true
WEB_PORT=5173
WEB_HOST=127.0.0.1
WIKI_NAME="Bioimaging core"
WIKI_DESCRIPTION=""
INTERNAL_API_URL=http://127.0.0.1:3001/internal/v1
# Quality check (system-logic §7.6). Rules file, resolved against the repo root.
QUALITY_RULES_PATH=rules/quality.md
# Models (§7.3, shared by API and worker). Defaults: anthropic / claude-sonnet-5-5.
# ANTHROPIC_API_KEY=
# AI_DEFAULT__PROVIDER=anthropic
# AI_JOBS__QUALITY_CHECK__MODEL=
# OPENAI_COMPAT_BASE_URL=
# Offline scoring of the check (spends model credits): cd services/worker && uv run mdwiki-worker eval DATASET.jsonl --out report.json
