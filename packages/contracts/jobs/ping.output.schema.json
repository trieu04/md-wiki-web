{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PingOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["echo", "workerVersion"],
  "properties": {
    "echo": { "type": "string", "description": "Must equal the original input.message." },
    "workerVersion": { "type": "string", "minLength": 1, "maxLength": 40 }
  }
}
