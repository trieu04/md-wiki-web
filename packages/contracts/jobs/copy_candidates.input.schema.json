{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CopyCandidatesInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sections",
    "threshold",
    "trigger"
  ],
  "properties": {
    "sections": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "title": "CandidateSection",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "anchor",
          "sectionHash",
          "text",
          "updatedAt"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sectionHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string",
            "maxLength": 20000
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trigger": {
      "title": "CredibilityJobTrigger",
      "type": "string",
      "enum": [
        "manual",
        "weekly",
        "daily",
        "submit",
        "internal"
      ]
    }
  }
}
