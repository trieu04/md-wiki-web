{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QualityCheckInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "bundleHash", "blocks", "rules"],
  "properties": {
    "subject": {
      "title": "QualitySubject",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "slug", "targetPath", "section"],
      "properties": {
        "kind": { "title": "QualitySubjectKind", "type": "string", "enum": ["proposal", "draft"] },
        "id": { "type": "string", "format": "uuid" },
        "slug": { "type": ["string", "null"], "maxLength": 80 },
        "targetPath": { "type": "string", "minLength": 1, "maxLength": 400 },
        "section": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "bundleHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "title": "QualityBlock",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
          "kind": {
            "title": "QualityBlockKind",
            "type": "string",
            "enum": ["proposal", "base", "source"]
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 500 },
          "text": { "type": "string" }
        }
      }
    },
    "rules": {
      "title": "QualityRulesInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "text"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 400 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 65536 }
      }
    }
  }
}
