{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobResult",
  "$defs": {
    "JobError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_]+$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  },
  "oneOf": [
    {
      "title": "JobResultOk",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "output"],
      "properties": {
        "status": { "const": "ok" },
        "output": {
          "oneOf": [
            { "$ref": "ping.output.schema.json" },
            { "$ref": "quality_check.output.schema.json" },
            { "$ref": "agent_review.output.schema.json" }
          ]
        }
      }
    },
    {
      "title": "JobResultFailed",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": { "const": "failed" },
        "error": { "$ref": "#/$defs/JobError" }
      }
    }
  ]
}
