{
  "name": "md-wiki-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint eslint.config.js && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test tools/design-ref/*.test.mjs tools/visual/*.test.mjs",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "contracts:gen": "node packages/contracts/scripts/contracts.mjs gen",
    "contracts:check": "node packages/contracts/scripts/contracts.mjs check",
    "design:shots": "playwright install chromium --only-shell && node tools/design-ref/render.mjs",
    "visual:shots": "playwright install chromium --only-shell && node tools/visual/shoot.mjs",
    "e2e": "playwright install chromium --only-shell && node e2e/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.61.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
