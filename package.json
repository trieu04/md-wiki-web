{
  "name": "md-wiki-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=22.12.0", "pnpm": ">=12" },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint eslint.config.js && turbo run lint",
    "typecheck": "turbo run typecheck",
